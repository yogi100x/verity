# Verity — copy to .env.local on each machine and fill in.
# Lanes B and C need NOTHING here. They build entirely from fixtures.

# --- Anthropic (Lanes A, D, E) ---
# Commercial API key from console.anthropic.com. NOT a claude.ai login.
ANTHROPIC_API_KEY=

# --- Supabase (Lanes A, D) ---
# Project must be London / eu-west-2 with Anonymous Sign-Ins ENABLED.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by seed scripts (Lane D). Never referenced in a component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Twilio (Lane E only, optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Modes ---
# live | fixtures | replay
# Default to fixtures locally so nobody burns tokens by accident.
# Override per-request with ?mode=
NEXT_PUBLIC_DEFAULT_MODE=fixtures
